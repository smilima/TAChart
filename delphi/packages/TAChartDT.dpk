{
  TAChart for Delphi / VCL -- design-time package.

  Registers the components on the tool palette and installs the component and
  property editors.  Install this one in the IDE; it pulls in TAChartRT.
}

package TAChartDT;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'TAChart for Delphi and C++Builder - design time'}
{$LIBSUFFIX AUTO}
{$OBJEXPORTALL ON}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide,
  TAChartRT;

contains
  TASubcomponentsEditor in '..\design\TASubcomponentsEditor.pas',
  TASeriesEditor in '..\design\TASeriesEditor.pas',
  TAToolEditors in '..\design\TAToolEditors.pas',
  TATransformsEditor in '..\design\TATransformsEditor.pas',
  TASeriesPropEditors in '..\design\TASeriesPropEditors.pas',
  TADataPointsEditor in '..\design\TADataPointsEditor.pas',
  TAChartReg in '..\design\TAChartReg.pas';

end.
