<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9E9B7A4D-1C21-4C2B-9E71-1B0F2D5A4C01}</ProjectGuid>
        <MainSource>TAChartRT.dpk</MainSource>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3806211</TargetedPlatforms>
        <AppType>Package</AppType>
        <ProjectName Condition="'$(ProjectName)'==''">TAChartRT</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64x' and '$(Base)'=='true') or '$(Base_Win64x)'!=''">
        <Base_Win64x>true</Base_Win64x>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='iOSDevice64' and '$(Cfg_2)'=='true') or '$(Cfg_2_iOSDevice64)'!=''">
        <Cfg_2_iOSDevice64>true</Cfg_2_iOSDevice64>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='OSX64' and '$(Cfg_2)'=='true') or '$(Cfg_2_OSX64)'!=''">
        <Cfg_2_OSX64>true</Cfg_2_OSX64>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='OSXARM64' and '$(Cfg_2)'=='true') or '$(Cfg_2_OSXARM64)'!=''">
        <Cfg_2_OSXARM64>true</Cfg_2_OSXARM64>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>..\.dcu\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_DcpOutput>$(BDSCOMMONDIR)\Dcp</DCC_DcpOutput>
        <DCC_BplOutput>$(BDSCOMMONDIR)\Bpl</DCC_BplOutput>
        <DCC_UnitSearchPath>..\src;..\compat;$(BDSCOMMONDIR)\Dcp\$(Platform);$(BDSCOMMONDIR)\Dcp;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>..\compat;$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_ResourcePath>..\compat;..\design;..\res;$(DCC_ResourcePath)</DCC_ResourcePath>
        <DCC_Description>TAChart for Delphi and C++Builder - runtime</DCC_Description>
        <DllSuffix>$(Auto)</DllSuffix>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <DCC_UsePackage>rtl;vcl;dbrtl;$(DCC_UsePackage)</DCC_UsePackage>
        <GenPackage>true</GenPackage>
        <GenDll>true</GenDll>
        <DCC_HppOutput>$(BDSCOMMONDIR)\hpp\$(Platform)</DCC_HppOutput>
        <DCC_CBuilderOutput>All</DCC_CBuilderOutput>
        <UsingDelphiRTL>true</UsingDelphiRTL>
        <RuntimeOnlyPackage>true</RuntimeOnlyPackage>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <SanitizedProjectName>TAChartRT</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Bde;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <DCC_DcpOutput>$(BDSCOMMONDIR)\Dcp\Win64</DCC_DcpOutput>
        <DCC_BplOutput>$(BDSCOMMONDIR)\Bpl\Win64</DCC_BplOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64x)'!=''">
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <DCC_DcpOutput>$(BDSCOMMONDIR)\Dcp\Win64x</DCC_DcpOutput>
        <DCC_BplOutput>$(BDSCOMMONDIR)\Bpl\Win64x</DCC_BplOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_iOSDevice64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_OSX64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_OSXARM64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="dbrtl.dcp"/>
        <DCCReference Include="vclimg.dcp"/>
        <DCCReference Include="..\compat\TAFPTypes.pas"/>
        <DCCReference Include="..\compat\TALCLCompat.pas"/>
        <DCCReference Include="..\compat\TANumLib.pas"/>
        <DCCReference Include="..\src\TAChartStrConsts.pas"/>
        <DCCReference Include="..\src\TAChartUtils.pas"/>
        <DCCReference Include="..\src\TAMath.pas"/>
        <DCCReference Include="..\src\TAGeometry.pas"/>
        <DCCReference Include="..\src\TAFitUtils.pas"/>
        <DCCReference Include="..\src\TADrawUtils.pas"/>
        <DCCReference Include="..\src\TATypes.pas"/>
        <DCCReference Include="..\src\TAEnumerators.pas"/>
        <DCCReference Include="..\src\TACustomSource.pas"/>
        <DCCReference Include="..\src\TASources.pas"/>
        <DCCReference Include="..\src\TAIntervalSources.pas"/>
        <DCCReference Include="..\src\TADbSource.pas"/>
        <DCCReference Include="..\src\TAAnimatedSource.pas"/>
        <DCCReference Include="..\src\TAAxisSource.pas"/>
        <DCCReference Include="..\src\TATextElements.pas"/>
        <DCCReference Include="..\src\TAChartAxisUtils.pas"/>
        <DCCReference Include="..\src\TAChartAxis.pas"/>
        <DCCReference Include="..\src\TATransformations.pas"/>
        <DCCReference Include="..\src\TALegend.pas"/>
        <DCCReference Include="..\src\TAStyles.pas"/>
        <DCCReference Include="..\src\TACustomSeries.pas"/>
        <DCCReference Include="..\src\TASeries.pas"/>
        <DCCReference Include="..\src\TAMultiSeries.pas"/>
        <DCCReference Include="..\src\TARadialSeries.pas"/>
        <DCCReference Include="..\src\TACustomFuncSeries.pas"/>
        <DCCReference Include="..\src\TAFuncSeries.pas"/>
        <DCCReference Include="..\src\TAGraph.pas"/>
        <DCCReference Include="..\src\TAGUIConnector.pas"/>
        <DCCReference Include="..\src\TADrawerCanvas.pas"/>
        <DCCReference Include="..\src\TATools.pas"/>
        <DCCReference Include="..\src\TADataTools.pas"/>
        <DCCReference Include="..\src\TANavigation.pas"/>
        <DCCReference Include="..\src\TAChartListbox.pas"/>
        <DCCReference Include="..\src\TAChartCombos.pas"/>
        <DCCReference Include="..\src\TAChartImageList.pas"/>
        <DCCReference Include="..\src\TAChartExtentLink.pas"/>
        <DCCReference Include="..\src\TALegendPanel.pas"/>
        <DCCReference Include="..\src\TAChartRegistration.pas"/>
        <DCCReference Include="..\src\TAPrint.pas"/>
        <DCCReference Include="..\src\TADrawerWMF.pas"/>
        <DCCReference Include="..\src\TADrawerSVG.pas"/>
        <DCCReference Include="..\src\TADrawerOpenGL.pas"/>
        <DCCReference Include="..\src\TAGPU.pas"/>
        <DCCReference Include="..\src\TAGLContext.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">TAChartRT.dpk</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="iOSDevice64">True</Platform>
                <Platform value="iOSSimARM64">True</Platform>
                <Platform value="OSX64">True</Platform>
                <Platform value="OSXARM64">True</Platform>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
                <Platform value="Win64x">True</Platform>
                <Platform value="WinARM64EC">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
